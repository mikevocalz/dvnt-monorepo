# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules

# Build outputs
dist
*.tsbuildinfo

# Turbo
.turbo

# Env
.env
.env.*
!.env.example

# Local editor/tooling state — never shared.
apps/web/AGENTS.md

# Local tooling state — machine-local, never shared.

# Gradle build output from workspace packages with native android/ dirs.
packages/*/android/build/

# Gradle build state — daemon locks, file hashes, caches. Never reproducible,
# never useful in a diff, and regenerated on every build.
.gradle/
