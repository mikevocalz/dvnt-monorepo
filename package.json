{
  "name": "universal-react-monorepo",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "turbo dev",
    "mobile": "pnpm --filter mobile dev",
    "mobile:android": "pnpm --filter mobile android",
    "mobile:ios": "pnpm --filter mobile ios",
    "mobile:web": "pnpm --filter mobile web",
    "web": "pnpm --filter web dev",
    "web:build": "pnpm --filter web build",
    "web:start": "pnpm --filter web start",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "sync-legal": "node scripts/sync-legal-content.mjs",
    "verify-migration": "node scripts/verify-migration.mjs",
    "postinstall": "(patch-package --patch-dir apps/mobile/patches || true) && for f in apps/mobile/scripts/patch-callkeep.sh apps/mobile/scripts/patch-expo-dev-launcher.sh apps/mobile/scripts/patch-insta-story.sh apps/mobile/scripts/patch-react-native-gradle-plugin.sh apps/mobile/scripts/patch-screen-transitions.sh apps/mobile/scripts/patch-vision-camera.sh; do [ -f \"$f\" ] && bash \"$f\" || true; done",
    "verify:parity": "node scripts/verify-port-parity.mjs",
    "verify:watch": "node scripts/verify-watch.mjs",
    "verify:sentry": "node scripts/verify-sentry.mjs",
    "verify:lynk": "node scripts/verify-lynk.mjs",
    "test": "pnpm run test:calls && pnpm run test:lynk-session",
    "test:calls": "node --test packages/app/features/call/join-effect-deps.test.ts packages/app/features/call/outgoing-signal.test.ts packages/app/lib/api/call-error-message.test.ts packages/app/components/feed/feed-media-mode.test.ts packages/app/components/feed/feed-sections.test.ts packages/app/components/feed/masonry-layout.test.ts",
    "test:lynk-session": "node --test packages/app/features/sneaky-lynk/session/machine.test.ts packages/ui/src/video/RoomTimer.countdown.test.ts packages/ui/src/video/ConnectionBanner.phase.test.ts packages/app/lib/user-label.test.ts packages/app/features/sneaky-lynk/ui/hand-queue.test.ts packages/app/lib/video/host-mute.test.ts packages/app/features/sneaky-lynk/session/moq-transport.test.ts packages/app/features/sneaky-lynk/ui/grid-layout.test.ts",
    "verify:functions": "node scripts/verify-edge-functions.mjs",
    "verify:functions:live": "node scripts/verify-edge-functions.mjs --live --project-ref npfjanxturvmjyevoyfo",
    "check:bundle": "node scripts/check-bundle-budget.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "devDependencies": {
    "eslint-plugin-no-barrel-files": "^2.2.0",
    "ts-morph": "^28.0.0",
    "turbo": "^2.9.17"
  },
  "pnpm": {
    "patchedDependencies": {
      "react-native-css@3.0.7": "pnpm-patches/react-native-css@3.0.7.patch"
    },
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "react-native": "0.86.0",
      "react-native-reanimated": "4.5.3",
      "react-native-worklets": "0.11.3",
      "react-native-web": "0.21.2",
      "@expo/dom-webview": "56.0.5",
      "hermes-compiler": "250829098.0.14",
      "react-native-nitro-modules": "0.35.6",
      "lightningcss": "1.30.1"
    },
    "onlyBuiltDependencies": [
      "@fishjam-cloud/react-native-webrtc",
      "@shopify/react-native-skia",
      "@swc/core",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
