# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# QR reader WASM, self-hosted by the apps/web postinstall (copy-zxing-wasm.cjs).
# Generated, versioned by zxing-wasm's own version, and regenerated on every
# install — including Vercel's, whose installCommand is `pnpm install`. Checking
# it in would let a stale binary outlive the JS glue it has to match.
/public/vendor/zxing/
