{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    // Lets features/sneaky-lynk/ui import "./user-labels.ts" with the explicit
    // extension Node's own test runner requires — packages/app already sets
    // this for the same reason. Safe because expo/tsconfig.base sets noEmit,
    // so nothing compiles out of this package.
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@dvnt/app/*": [
        "../../packages/app/*"
      ],
      "react-native-screen-transitions": [
        "../../node_modules/react-native-screen-transitions/lib/typescript/shared/index.d.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "babel.config.js",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "server",
    "supabase/functions",
    "scripts",
    // Build output is not source. A derivedDataPath inside the project drags
    // vendored fixtures into the typecheck — moq-kit ships a BINARY `ac3.ts`
    // test file, which fails with "File appears to be binary" for a file
    // nobody in this repo wrote.
    "ios/build",
    "android/build",
    "android/app/build",
    ".expo"
  ]
}
