--- a/node_modules/react-native-moq/MoQ.podspec
+++ b/node_modules/react-native-moq/MoQ.podspec
@@ -18,9 +18,36 @@
 
   install_modules_dependencies(s)
 
+  # dvnt pin: v0.3.0's own manifest declares moq-swift `from: "0.2.27"`, which
+  # SPM resolves to 0.4.x across a breaking rewrite — the tag cannot compile.
+  # moq-kit main fixed this (96b8028, pins moq-swift 0.4.1) but is untagged.
+  # Drop this patch when moq-kit tags a release and react-native-moq picks it up:
+  # https://github.com/software-mansion-labs/react-native-moq/issues/1
   spm_dependency(s,
     url: 'https://github.com/software-mansion-labs/moq-kit.git',
-    requirement: { kind: 'exactVersion', version: '0.3.0' },
+    requirement: { kind: 'revision', revision: '7ed3aeb7a169401fbe23f9210decdd9b2df8a995' },
     products: ['MoQKit']
   )
+
+  # Constraint-only pins (products: [] — nothing links or embeds these
+  # directly; they exist to constrain SPM's resolution). A dependency's
+  # Package.resolved is IGNORED when it is consumed as a dependency, so the
+  # whole moq stack re-floats at every level:
+  #   moq-kit main        -> moq-swift  from: 0.4.1          -> 0.4.3
+  #   moq-swift 0.4.3     -> moq-ffi    upToNextMinor 0.3.10 -> 0.3.10
+  # and moq-ffi 0.3.10 adds `case Video` to MoqError, which moq-kit's
+  # exhaustive switch (Errors.swift:47) does not handle -> compile error.
+  # Even moq-swift 0.4.1 floats ffi upToNextMinor(0.3.3) -> 0.3.10, so BOTH
+  # levels must be pinned. 0.4.1 + 0.3.3 is exactly the set moq-kit's own
+  # Package.resolved blesses at the pinned revision.
+  spm_dependency(s,
+    url: 'https://github.com/moq-dev/moq-swift',
+    requirement: { kind: 'exactVersion', version: '0.4.1' },
+    products: []
+  )
+  spm_dependency(s,
+    url: 'https://github.com/moq-dev/moq-swift-ffi',
+    requirement: { kind: 'exactVersion', version: '0.3.3' },
+    products: []
+  )
 end
