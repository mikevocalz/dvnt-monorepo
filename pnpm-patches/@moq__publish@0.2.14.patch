+// DVNT: @moq/publish 0.2.14 discards encoder orientation metadata.
+// Bake only explicit frame transforms into pixels before encoding. Never infer
+// orientation from device angle, aspect ratio, or camera facing mode.
+export function createOrientationNormalizer() {
+  let canvas;
+  return function normalize(frame) {
+    // Keep the zero-copy path for already upright frames (including browsers
+    // which have already applied camera orientation to the captured pixels).
+    if (!frame.rotation && !frame.flip) return frame;
+    try {
+      const width = frame.displayWidth;
+      const height = frame.displayHeight;
+      if (!canvas) canvas = new OffscreenCanvas(width, height);
+      if (canvas.width !== width) canvas.width = width;
+      if (canvas.height !== height) canvas.height = height;
+      const context = canvas.getContext("2d");
+      if (!context) throw new Error("Video orientation normalization needs a 2D canvas");
+      // drawImage applies VideoFrame rotation/flip/visibleRect once, in display
+      // coordinates. Constructing from canvas yields rotation=0 and flip=false.
+      context.clearRect(0, 0, width, height);
+      context.drawImage(frame, 0, 0, width, height);
+      return new VideoFrame(canvas, {
+        timestamp: frame.timestamp,
+        ...(frame.duration == null ? {} : { duration: frame.duration }),
+      });
+    } finally {
+      // Consume ownership only when replacing the frame, including failures.
+      // The returned frame remains owned by the SDK's existing frame lifecycle.
+      frame.close();
+    }
+  };
+}
+
+// VideoFrame(video) can retain a camera's internal sensor rotation on WebKit
+// without exposing rotation/flip to JavaScript. Paint the video presentation
+// first so the encoder receives exactly those pixels, with no metadata needed.
+// Read the live displayed dimensions on every frame (including camera switches),
+// never the track's startup settings or the viewer's device orientation.
+export function createVideoElementCapture() {
+  let canvas;
+  return function capture(video, timestamp) {
+    const width = video.videoWidth;
+    const height = video.videoHeight;
+    if (video.readyState < 2 || !width || !height) {
+      throw new DOMException("Video element has no current frame", "InvalidStateError");
+    }
+    if (!canvas) canvas = document.createElement("canvas");
+    if (canvas.width !== width) canvas.width = width;
+    if (canvas.height !== height) canvas.height = height;
+    const context = canvas.getContext("2d");
+    if (!context) throw new Error("Video capture needs a 2D canvas");
+    context.clearRect(0, 0, width, height);
+    context.drawImage(video, 0, 0, width, height);
+    return new VideoFrame(canvas, { timestamp });
+  };
+}
